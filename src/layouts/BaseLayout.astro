---
import '../styles/global.css';
import { brand } from '../data/brand';
import { assetUrl } from '../lib/paths';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogImageType?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  canonicalUrl?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  extraSchema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Photobooth & Undangan Digital | Ruang Kilas',
  description = 'Rayakan momen bersama Ruang Kilas: photobooth online, photobooth acara, dan undangan digital personal yang mudah dibagikan.',
  keywords = 'photobooth online, photobooth online gratis, photo booth online indonesia, photo strip online, photobooth browser, vintage photo booth, cetak photostrip, photobooth webcam, efek lensa vintage, fisheye camera online, frame photobooth estetik, ruang kilas, aplikasi photobooth gratis',
  ogImage = '/images/og-share.png',
  ogImageType = Astro.props.ogImage?.match(/\.jpe?g$/i) ? 'image/jpeg' : 'image/png',
  ogImageAlt = 'Ruang Kilas ? Photobooth dan Undangan Digital',
  ogType = 'website',
  canonicalUrl,
  noindex = false,
  breadcrumbs,
  extraSchema,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://ruangkilas.my.id';

// GitHub Pages serves directory builds from `/path/` and 301-redirects `/path`,
// so every canonical, breadcrumb and schema URL must use the trailing-slash form.
function withTrailingSlash(value: string): string {
  const url = new URL(value, siteUrl);
  if (/\.[a-z0-9]+$/i.test(url.pathname)) return url.toString();
  if (!url.pathname.endsWith('/')) url.pathname = `${url.pathname}/`;
  return url.toString();
}

const canonical = withTrailingSlash(canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).toString());
const faviconUrl = assetUrl('/favicon.svg');
const logoUrl = new URL(assetUrl('/favicon-512.png'), siteUrl).toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(assetUrl(ogImage), siteUrl).toString();
const sitemapUrl = new URL(assetUrl('/sitemap.xml'), siteUrl).toString();
const manifestUrl = assetUrl('/site.webmanifest');
const studioUrl = withTrailingSlash(`${siteUrl}/studio`);
const livePhotoBg = `url('${assetUrl('/images/friends-photo-booth.jpg')}')`;

// Structured Data (JSON-LD)
const websiteId = `${siteUrl}/#website`;
const organizationId = `${siteUrl}/#organization`;
const webApplicationId = `${siteUrl}/#webapp`;
const logoId = `${siteUrl}/#logo`;

const schemaGraph: any[] = [
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: 'id-ID',
    isPartOf: {
      '@id': websiteId,
    },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: ogImageUrl,
      width: 1200,
      height: 630,
      caption: ogImageAlt,
    },
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${siteUrl}/`,
    name: brand.name,
    alternateName: [`${brand.name} Photobooth Online`, 'RuangKilas'],
    description: 'Photobooth online, photobooth acara, dan undangan digital untuk merayakan momen spesial.',
    inLanguage: 'id-ID',
    publisher: {
      '@id': organizationId,
    },
  },
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: brand.name,
    alternateName: `${brand.name} Photobooth`,
    url: `${siteUrl}/`,
    logo: {
      '@type': 'ImageObject',
      '@id': logoId,
      url: logoUrl,
      contentUrl: logoUrl,
      width: 512,
      height: 512,
      caption: `Logo ${brand.name}`,
    },
    image: {
      '@id': logoId,
    },
    email: brand.email,
    telephone: brand.phone,
    sameAs: [brand.instagram, brand.tiktok],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: brand.email,
      telephone: brand.phone,
      availableLanguage: ['id', 'en'],
      areaServed: 'ID',
    },
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Gedung Kemang Point Lt. 3, Jl. Kemang Raya No. 3, Bangka',
      addressLocality: 'Jakarta Selatan',
      addressRegion: 'DKI Jakarta',
      postalCode: '12730',
      addressCountry: 'ID',
    },
  },
  {
    '@type': 'WebApplication',
    '@id': webApplicationId,
    name: `${brand.name} Photobooth Online`,
    url: studioUrl,
    image: ogImageUrl,
    applicationCategory: 'PhotographyApplication',
    operatingSystem: 'Any modern web browser (Chrome, Safari, Firefox, Edge)',
    browserRequirements: 'Requires JavaScript, HTML5 Canvas, WebRTC camera access',
    inLanguage: 'id-ID',
    isPartOf: {
      '@id': websiteId,
    },
    publisher: {
      '@id': organizationId,
    },
    description: 'Photobooth online gratis di browser dengan efek lensa, bingkai, dan unduhan photostrip.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'IDR',
      availability: 'https://schema.org/InStock',
    },
    featureList: [
      'Webcam photobooth online instan di browser tanpa aplikasi',
      'Efek kamera vintage: Fisheye 360, Leica 35mm, Digicam 2004, VHS Camcorder, Dreamy Soft Prism',
      'Pilihan bingkai estetik: Y2K Cyber, Retro Receipt, Cinema Ticket, 90s Yearbook, Museum Art',
      'Unduh photostrip cetak resolusi tinggi 300 DPI dan rekaman Boomerang WebM',
      '100% privasi aman diproses lokal di browser perangkat Anda',
    ],
  },
];

if (breadcrumbs && breadcrumbs.length > 0) {
  const breadcrumbId = `${canonical}#breadcrumb`;
  schemaGraph.push({
    '@type': 'BreadcrumbList',
    '@id': breadcrumbId,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: withTrailingSlash(crumb.item.startsWith('http') ? crumb.item : `${siteUrl}${crumb.item}`),
    })),
  });
  schemaGraph[0].breadcrumb = { '@id': breadcrumbId };
}

if (extraSchema) {
  if (Array.isArray(extraSchema)) {
    schemaGraph.push(...extraSchema);
  } else {
    schemaGraph.push(extraSchema);
  }
}

const fullSchema = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Ruang Kilas" />
    <meta name="publisher" content="Ruang Kilas" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="google-site-verification" content="yggRLc15vxLIfPo3bKb_PtreiOBBsKbiZtu1IPmwWmE" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={canonical} />
    <link rel="alternate" hreflang="id-ID" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <link rel="manifest" href={manifestUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ruangkilas" />
    <meta name="twitter:creator" content="@ruangkilas" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Theme & App Metadata -->
    <meta name="theme-color" content="#FFF3B0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Ruang Kilas" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Security & Permissions -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; form-action 'self'; base-uri 'self'; upgrade-insecure-requests;" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(self), microphone=(), geolocation=(), interest-cohort=()" />

    <!-- Icons -->
    <link rel="icon" href={assetUrl('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href={assetUrl('/favicon-48.png')} />
    <link rel="icon" type="image/png" sizes="96x96" href={assetUrl('/favicon-96.png')} />
    <link rel="icon" type="image/png" sizes="144x144" href={assetUrl('/favicon-144.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={assetUrl('/favicon-192.png')} />
    <link rel="icon" type="image/png" sizes="512x512" href={assetUrl('/favicon-512.png')} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={assetUrl('/favicon-180.png')} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(fullSchema)} />

    <style is:global define:vars={{ livePhotoBg }}>
      .live-photo,
      .sample-picture {
        background-image: var(--livePhotoBg) !important;
      }
    </style>
  </head>
  <body id="top">
    <slot />
  </body>
</html>
