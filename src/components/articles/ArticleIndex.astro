---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import ArticleCard from '../../components/articles/ArticleCard.astro';
import type { Article } from '../../data/articles';
import { articleExtras } from '../../data/article-extras';
import { assetUrl } from '../../lib/paths';

interface Props {
  allArticles: Article[];
  page: number;
  pageSize: number;
  total: number;
  pageCount: number;
}

const { allArticles, page, pageSize, total, pageCount } = Astro.props;
const firstItem = (page - 1) * pageSize + 1;
const lastItem = Math.min(page * pageSize, total);
const pageHref = (pageNumber: number) => pageNumber === 1
  ? assetUrl('/artikel/')
  : assetUrl(`/artikel/page/${pageNumber}/`);
const visiblePages = Array.from({ length: pageCount }, (_, index) => index + 1)
  .filter((pageNumber) => pageNumber === 1 || pageNumber === pageCount || Math.abs(pageNumber - page) <= 1);
const breadcrumbs = [{ name: 'Beranda', item: '/' }, { name: 'Artikel', item: '/artikel/' }];
const categories = [...new Set(allArticles.map((article) => article.category))].sort((a, b) => a.localeCompare(b, 'id'));
---

<BaseLayout
  title={`Artikel & Inspirasi Photobooth dan Undangan Digital${page > 1 ? ` — Halaman ${page}` : ''} | Ruang Kilas`}
  description="Temukan panduan photobooth online, ide foto, dan tips undangan digital untuk merayakan momen spesialmu."
  breadcrumbs={breadcrumbs}
>
  <SiteHeader active="/artikel/" />
  <main>
    <section class="und-hero und-hero-small">
      <div class="und-hero-inner">
        <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href={assetUrl('/')}>Beranda</a><span aria-hidden="true">/</span><span aria-current="page">Artikel</span></nav>
        <h1>Cerita dan inspirasi<br /><em>untuk setiap momen.</em></h1>
        <p class="und-lede">Panduan dan ide seputar photobooth, undangan digital, dan cara merayakan kebersamaan.</p>
      </div>
    </section>
    <section
      class="und-section article-list"
      aria-label="Daftar artikel"
      data-base={assetUrl('/artikel/')}
      data-page-prefix={assetUrl('/artikel/page/')}
      data-current-page={page}
      data-page-size={pageSize}
    >
      <form class="article-filters" role="search" aria-label="Cari dan filter artikel" action={assetUrl('/artikel/')} method="get">
        <label class="article-search-field">
          <span>Cari artikel</span>
          <input type="search" name="q" placeholder="Cari judul atau topik…" autocomplete="off" aria-controls="article-grid" />
        </label>
        <label class="article-category-field">
          <span>Topik</span>
          <select name="category" aria-controls="article-grid">
            <option value="">Semua topik</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </label>
        <button class="article-clear-filters" type="reset" hidden>Hapus filter</button>
      </form>
      <p class="article-results" aria-live="polite">Menampilkan {firstItem}–{lastItem} dari {total} artikel</p>
      <div class="article-empty-state" role="status" hidden>
        <p>Tidak ada artikel yang cocok dengan pencarianmu. Coba kata kunci atau topik lain.</p>
        <button class="article-empty-reset" type="button">Hapus filter</button>
      </div>
      <div class="und-grid und-grid-3" id="article-grid">
        {allArticles.map((article, index) => (
          <div
            class="article-result-item"
            data-category={article.category}
            data-search={`${article.title} ${article.category} ${article.description} ${article.sections.map((section) => section.heading).join(' ')} ${(articleExtras[article.slug]?.sections ?? []).map((section) => section.heading).join(' ')}`}
            data-page={Math.ceil((index + 1) / pageSize)}
            hidden={Math.ceil((index + 1) / pageSize) !== page}
          >
            <ArticleCard article={article} />
          </div>
        ))}
      </div>
      <nav class="article-pagination" aria-label="Navigasi halaman artikel" hidden={pageCount <= 1}>
        {page > 1
          ? <a class="article-page-link article-page-previous" href={pageHref(page - 1)} rel="prev">&larr; <span class="article-page-label">Sebelumnya</span></a>
          : <span class="article-page-link article-page-placeholder" aria-hidden="true"></span>}
        <ol>
          {visiblePages.map((pageNumber, index) => (
            <>
              {index > 0 && visiblePages[index - 1] !== pageNumber - 1 && <li class="article-page-ellipsis" aria-hidden="true">…</li>}
              <li><a href={pageHref(pageNumber)} aria-label={`Halaman ${pageNumber}`} aria-current={pageNumber === page ? 'page' : undefined}>{pageNumber}</a></li>
            </>
          ))}
        </ol>
        {page < pageCount
          ? <a class="article-page-link article-page-next" href={pageHref(page + 1)} rel="next"><span class="article-page-label">Berikutnya</span> &rarr;</a>
          : <span class="article-page-link article-page-placeholder" aria-hidden="true"></span>}
      </nav>
    </section>
  </main>
  <script>
    interface ArticleEntry { el: HTMLElement; category: string; text: string; }

    const normalize = (value: string) => value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLocaleLowerCase('id')
      .replace(/\s+/g, ' ')
      .trim();

    const section = document.querySelector<HTMLElement>('.article-list');

    if (section) {
      const form = section.querySelector<HTMLFormElement>('.article-filters');
      const searchInput = form?.querySelector<HTMLInputElement>('input[name="q"]');
      const categorySelect = form?.querySelector<HTMLSelectElement>('select[name="category"]');
      const clearButton = form?.querySelector<HTMLButtonElement>('.article-clear-filters');
      const emptyState = section.querySelector<HTMLElement>('.article-empty-state');
      const emptyReset = section.querySelector<HTMLButtonElement>('.article-empty-reset');
      const grid = section.querySelector<HTMLElement>('#article-grid');
      const resultsText = section.querySelector<HTMLElement>('.article-results');
      const pagination = section.querySelector<HTMLElement>('.article-pagination');

      const base = section.dataset.base ?? '/artikel/';
      const pagePrefix = section.dataset.pagePrefix ?? `${base}page/`;
      const pageSize = Number(section.dataset.pageSize ?? 12) || 12;
      const initialPage = Math.max(1, Number(section.dataset.currentPage ?? 1) || 1);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const entries: ArticleEntry[] = [...section.querySelectorAll<HTMLElement>('.article-result-item')].map((el) => ({
        el,
        category: el.dataset.category ?? '',
        text: normalize(el.dataset.search ?? ''),
      }));

      const state = { query: '', category: '', page: initialPage };
      const hasFilters = () => Boolean(state.query || state.category);

      const filteredEntries = () => {
        const tokens = normalize(state.query).split(' ').filter(Boolean);
        return entries.filter((entry) => {
          if (state.category && entry.category !== state.category) return false;
          return tokens.every((token) => entry.text.includes(token));
        });
      };

      const pageHref = (pageNumber: number) => {
        if (!hasFilters()) return pageNumber === 1 ? base : `${pagePrefix}${pageNumber}/`;
        const params = new URLSearchParams();
        if (state.query) params.set('q', state.query);
        if (state.category) params.set('category', state.category);
        if (pageNumber > 1) params.set('page', String(pageNumber));
        const query = params.toString();
        return query ? `${base}?${query}` : base;
      };

      const pageNumbers = (totalPages: number) => {
        const pages: number[] = [];
        for (let pageNumber = 1; pageNumber <= totalPages; pageNumber += 1) {
          if (pageNumber === 1 || pageNumber === totalPages || Math.abs(pageNumber - state.page) <= 1) pages.push(pageNumber);
        }
        return pages;
      };

      const renderPagination = (totalPages: number) => {
        if (!pagination) return;
        if (totalPages <= 1) {
          pagination.hidden = true;
          pagination.replaceChildren();
          return;
        }

        pagination.hidden = false;
        const pages = pageNumbers(totalPages);
        const items: string[] = [];
        pages.forEach((pageNumber, index) => {
          if (index > 0 && pages[index - 1] !== pageNumber - 1) {
            items.push('<li class="article-page-ellipsis" aria-hidden="true">…</li>');
          }
          const current = pageNumber === state.page ? ' aria-current="page"' : '';
          items.push(`<li><a href="${pageHref(pageNumber)}" aria-label="Halaman ${pageNumber}"${current}>${pageNumber}</a></li>`);
        });

        const previous = state.page > 1
          ? `<a class="article-page-link article-page-previous" href="${pageHref(state.page - 1)}" rel="prev">&larr; <span class="article-page-label">Sebelumnya</span></a>`
          : '<span class="article-page-link article-page-placeholder" aria-hidden="true"></span>';
        const next = state.page < totalPages
          ? `<a class="article-page-link article-page-next" href="${pageHref(state.page + 1)}" rel="next"><span class="article-page-label">Berikutnya</span> &rarr;</a>`
          : '<span class="article-page-link article-page-placeholder" aria-hidden="true"></span>';

        pagination.innerHTML = `${previous}<ol>${items.join('')}</ol>${next}`;
      };

      const render = (options: { scroll?: boolean } = {}) => {
        const list = filteredEntries();
        const totalPages = Math.max(1, Math.ceil(list.length / pageSize));
        state.page = Math.min(Math.max(state.page, 1), totalPages);

        const startIndex = (state.page - 1) * pageSize;
        const visible = new Set(list.slice(startIndex, startIndex + pageSize).map((entry) => entry.el));
        for (const entry of entries) entry.el.hidden = !visible.has(entry.el);

        const filtered = hasFilters();
        if (clearButton) clearButton.hidden = !filtered;
        if (emptyState) emptyState.hidden = list.length > 0;
        if (grid) grid.hidden = list.length === 0;
        if (resultsText) {
          resultsText.textContent = list.length === 0
            ? '0 artikel ditemukan.'
            : `Menampilkan ${startIndex + 1}–${Math.min(startIndex + pageSize, list.length)} dari ${list.length} artikel${filtered ? ' yang cocok' : ''}`;
        }

        renderPagination(totalPages);

        if (options.scroll && list.length > 0) {
          form?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
        }
      };

      const syncUrl = (mode: 'push' | 'replace') => {
        const url = pageHref(state.page);
        if (mode === 'push') history.pushState({ page: state.page }, '', url);
        else history.replaceState({ page: state.page }, '', url);
      };

      const readUrlState = () => {
        const params = new URLSearchParams(window.location.search);
        const pathMatch = window.location.pathname.match(/\/artikel\/page\/(\d+)\/?$/);
        const urlPage = Number(params.get('page') ?? pathMatch?.[1] ?? initialPage);
        let query = params.get('q') ?? '';
        let category = params.get('category') ?? '';

        if (category && categorySelect && ![...categorySelect.options].some((option) => option.value === category)) {
          category = '';
        }

        state.query = query;
        state.category = category;
        state.page = Number.isFinite(urlPage) && urlPage > 0 ? urlPage : initialPage;
        if (searchInput) searchInput.value = query;
        if (categorySelect) categorySelect.value = category;
      };

      const applyFilters = () => {
        state.query = searchInput?.value.trim() ?? '';
        state.category = categorySelect?.value ?? '';
        state.page = 1;
        syncUrl('replace');
        render();
      };

      let inputTimer: number | undefined;
      searchInput?.addEventListener('input', () => {
        window.clearTimeout(inputTimer);
        inputTimer = window.setTimeout(applyFilters, 140);
      });
      searchInput?.addEventListener('search', () => {
        window.clearTimeout(inputTimer);
        applyFilters();
      });
      categorySelect?.addEventListener('change', applyFilters);
      form?.addEventListener('reset', () => {
        window.setTimeout(() => {
          state.query = '';
          state.category = '';
          state.page = 1;
          syncUrl('replace');
          render();
        }, 0);
      });
      emptyReset?.addEventListener('click', () => form?.reset());

      pagination?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        const link = target?.closest<HTMLAnchorElement>('a[href]');
        if (!link || !pagination.contains(link)) return;

        event.preventDefault();
        const url = new URL(link.href, window.location.href);
        const pathMatch = url.pathname.match(/\/artikel\/page\/(\d+)\/?$/);
        const pageNumber = Number(url.searchParams.get('page') ?? pathMatch?.[1] ?? 1);
        if (!Number.isFinite(pageNumber) || pageNumber < 1) return;

        state.page = pageNumber;
        syncUrl('push');
        render({ scroll: true });
      });

      window.addEventListener('popstate', () => {
        readUrlState();
        render();
      });

      readUrlState();
      render();
    }
  </script>
  <SiteFooter />
</BaseLayout>
