---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import ArticleCard from '../../components/articles/ArticleCard.astro';
import type { Article } from '../../data/articles';
import { assetUrl } from '../../lib/paths';

interface Props {
  articles: Article[];
  page: number;
  pageSize: number;
  total: number;
  pageCount: number;
}

const { articles, page, pageSize, total, pageCount } = Astro.props;
const firstItem = (page - 1) * pageSize + 1;
const lastItem = Math.min(page * pageSize, total);
const pageHref = (pageNumber: number) => pageNumber === 1
  ? assetUrl('/artikel/')
  : assetUrl(`/artikel/page/${pageNumber}/`);
const visiblePages = Array.from({ length: pageCount }, (_, index) => index + 1)
  .filter((pageNumber) => pageNumber === 1 || pageNumber === pageCount || Math.abs(pageNumber - page) <= 1);
const breadcrumbs = [{ name: 'Beranda', item: '/' }, { name: 'Artikel', item: '/artikel/' }];
---

<BaseLayout
  title={`Artikel & Inspirasi Photobooth dan Undangan Digital${page > 1 ? ` — Halaman ${page}` : ''} | Ruang Kilas`}
  description="Temukan panduan photobooth online, ide foto, dan tips undangan digital untuk merayakan momen spesialmu."
  breadcrumbs={breadcrumbs}
>
  <SiteHeader active="/artikel/" />
  <main>
    <section class="und-hero und-hero-small">
      <div class="und-hero-inner">
        <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href={assetUrl('/')}>Beranda</a><span aria-hidden="true">/</span><span aria-current="page">Artikel</span></nav>
        <h1>Cerita dan inspirasi<br /><em>untuk setiap momen.</em></h1>
        <p class="und-lede">Panduan dan ide seputar photobooth, undangan digital, dan cara merayakan kebersamaan.</p>
      </div>
    </section>
    <section class="und-section article-list" aria-label="Daftar artikel">
      <p class="article-results" aria-live="polite">Menampilkan {firstItem}–{lastItem} dari {total} artikel</p>
      <div class="und-grid und-grid-3">
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
      {pageCount > 1 && (
        <nav class="article-pagination" aria-label="Navigasi halaman artikel">
          {page > 1 && <a class="article-page-link article-page-previous" href={pageHref(page - 1)} rel="prev">&larr; Sebelumnya</a>}
          <ol>
            {visiblePages.map((pageNumber, index) => (
              <>
                {index > 0 && visiblePages[index - 1] !== pageNumber - 1 && <li class="article-page-ellipsis" aria-hidden="true">…</li>}
                <li><a href={pageHref(pageNumber)} aria-label={`Halaman ${pageNumber}`} aria-current={pageNumber === page ? 'page' : undefined}>{pageNumber}</a></li>
              </>
            ))}
          </ol>
          {page < pageCount && <a class="article-page-link article-page-next" href={pageHref(page + 1)} rel="next">Berikutnya &rarr;</a>}
        </nav>
      )}
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
