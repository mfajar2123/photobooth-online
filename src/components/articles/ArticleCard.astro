---
import type { Article } from '../../data/articles';
import { assetUrl } from '../../lib/paths';
interface Props { article: Article }
const { article } = Astro.props;
const href = assetUrl(`/artikel/${article.slug}/`);
const imageSrc = article.image.startsWith('http') ? article.image : assetUrl(article.image);
---
<article class="und-card article-card">
  <a class="und-card-media" href={href} tabindex="-1" aria-hidden="true">
    <img src={imageSrc} alt="" width="800" height="500" loading="lazy" decoding="async" />
  </a>
  <div class="und-card-body">
    <span class="und-card-tag">{article.category}</span>
    <h2 class="article-card-title"><a href={href}>{article.title}</a></h2>
    <p class="article-card-desc">{article.description}</p>
    <a class="text-link article-card-link" href={href} aria-label={`Baca artikel: ${article.title}`}>Baca artikel <span aria-hidden="true">&#8599;</span></a>
  </div>
</article>
