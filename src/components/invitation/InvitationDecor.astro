            <circle cx="260" cy="450" r="3" /><circle cx="1180" cy="620" r="3" />
            <path d="M715 55l5 12 12 5-12 5-5 12-5-12-12-5 12-5z" />
            <path d="M720 810l4 9 9 4-9 4-4 9-4-9-9-4 9-4z" />
