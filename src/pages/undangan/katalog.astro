---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import { invitationTemplates } from '../../data/templates';
import { assetUrl } from '../../lib/paths';

const breadcrumbs = [
  { name: 'Beranda', item: '/' },
  { name: 'Undangan Digital', item: '/undangan' },
  { name: 'Katalog Template', item: '/undangan/katalog' },
];

const categories = ['Semua', ...invitationTemplates.map((item) => item.name)];
---

<BaseLayout
  title="Katalog Template Undangan Digital | Ruang Kilas"
  description="Pilih template undangan pernikahan digital: Serat, Linen, Garden, Monokrom, Kertas, dan Senja. Setiap template bisa dicoba langsung sebelum dipilih."
  keywords="template undangan digital, katalog undangan wedding, undangan pernikahan online"
  breadcrumbs={breadcrumbs}
>
  <SiteHeader ctaLabel="Buat undangan" ctaHref="/undangan/custom/" />

  <main>
    <section class="und-hero und-hero-small">
      <div class="und-hero-inner">
        <p class="section-kicker">KATALOG TEMPLATE</p>
        <h1>Pilih arah visualnya,<br /><em>sisanya kami sesuaikan.</em></h1>
        <p class="und-lede">Temukan gaya yang terasa seperti kalian. Coba demonya, lalu pilih template untuk disesuaikan dengan cerita dan hari bahagiamu.</p>
      </div>
    </section>

    <section class="section-pad und-section">
      <div class="und-filters" role="group" aria-label="Filter template">
        {categories.map((category, index) => (
          <button
            type="button"
            class={`und-filter${index === 0 ? ' is-active' : ''}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-filter={category}
          >{category}</button>
        ))}
      </div>

      <p class="und-results" role="status" aria-live="polite" id="template-count">6 template untuk dijelajahi</p>
      <div class="und-grid und-grid-3" id="template-grid">
        {invitationTemplates.map((template) => (
          <article class="und-card und-template" data-category={template.name}>
            <a class="und-card-media" href={assetUrl(`/undangan/${template.demoSlug}/`)} aria-label={`Lihat demo ${template.name}`}>
              <img src={assetUrl(template.cover)} alt={`Template ${template.name}`} loading="lazy" decoding="async" />
            </a>
            <div class="und-card-body">
              <span class="und-card-tag">{template.tagline}</span>
              <h2 class="und-template-name">{template.name}</h2>
              <p>{template.description}</p>

              <div class="und-card-actions">
                <a class="button-primary" href={assetUrl(`/undangan/${template.demoSlug}/`)}>Lihat demo <span aria-hidden="true">↗</span></a>
                <a class="text-link" href={`${assetUrl('/undangan/custom/')}?template=${encodeURIComponent(template.name)}`}>Pakai template ini</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.und-filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.und-template'));

    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        const value = filter.dataset.filter ?? 'Semua';
        filters.forEach((item) => {
          const active = item === filter;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        cards.forEach((card) => {
          const match = value === 'Semua' || card.dataset.category === value;
          card.hidden = !match;
        });
        const count = cards.filter((card) => !card.hidden).length;
        const status = document.getElementById('template-count');
        if (status) status.textContent = `${count} template ditampilkan`;
      });
    });
  </script>
</BaseLayout>
