---
import { assetUrl } from '../lib/paths';

const destination = assetUrl('/wedding-ripki-aura');
const site = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const canonical = new URL(destination, site).toString();
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonical} />
    <title>Dialihkan ke Ripki &amp; Aura</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>Halaman ini telah pindah ke <a href={destination}>wedding-ripki-aura</a>.</p>
  </body>
</html>
