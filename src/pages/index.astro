---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand, faqs } from '../data/brand';
---

<BaseLayout>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Mivora Photo, ke atas"><span>✦</span> MIVORA <i>PHOTO</i></a>
    <nav aria-label="Navigasi utama">
      <a href="#lenses">Efek lensa</a>
      <a href="#frames">Koleksi frame</a>
      <a href="/panduan">Panduan</a>
      <a href="/studio">Studio</a>
    </nav>
    <a class="header-cta" href="/studio">Buka photobooth <span>↗</span></a>
  </header>

  <main id="top">
    <section class="hero-section">
      <div class="hero-bg-photos" aria-hidden="true">
        <div class="hero-mini-photo photo-left-top">
          <div class="mini-frame">
            <img src="/images/friends-photo-booth.jpg" alt="" class="mini-img img-classic-warm" />
          </div>
          <span class="mini-caption">analog '04</span>
        </div>
        <div class="hero-mini-photo photo-left-bottom">
          <div class="mini-frame">
            <img src="/images/friends-photo-booth.jpg" alt="" class="mini-img img-classic-film" />
          </div>
          <span class="mini-caption">besties</span>
        </div>
        <div class="hero-mini-photo photo-right-top">
          <div class="mini-frame">
            <img src="/images/friends-photo-booth.jpg" alt="" class="mini-img img-classic-mono" />
          </div>
          <span class="mini-caption">instant roll</span>
        </div>
      </div>
      <div class="hero-copy">
        <h1 class="split-title">Abadikan momen seru,<br /><em>langsung dari browser lo.</em></h1>
        <p class="hero-lede">Nggak perlu antre di mall. Pilih efek lensa kamera mahal, tempel stiker sesuka hati, dan simpan photostrip estetik bareng bestie detik ini juga.</p>
        <div class="hero-actions"><a class="button-primary" href="/studio">Mulai photobooth sekarang <span>↗</span></a><a class="button-secondary" href="#frames">Lihat koleksi frame <span>↓</span></a></div>
      </div>
    </section>

    <section class="lens-section section-pad" id="lenses">
      <div class="lens-copy">
        <h2>Satu webcam.<br /><em>Berasa sewa lensa studio.</em></h2>
        <p class="section-intro">Pilih efek lensa kamera di bawah untuk melihat simulasi pratinjau foto secara langsung.</p>
        <div class="lens-showcase-list" role="tablist" aria-label="Preview efek lensa">
          <button class="lens-showcase-option is-active" type="button" role="tab" aria-selected="true" data-lens="fisheye">
            <span class="lens-num">01</span>
            <div class="lens-info">
              <strong>FISHEYE 360° ULTRA-WIDE</strong>
              <small>Cembung ekstrem, ala kamera aksi 90an.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
          <button class="lens-showcase-option" type="button" role="tab" aria-selected="false" data-lens="leica">
            <span class="lens-num">02</span>
            <div class="lens-info">
              <strong>LEICA 35MM FILM GRAIN</strong>
              <small>Hangat, bertekstur, dengan light leak tipis.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
          <button class="lens-showcase-option" type="button" role="tab" aria-selected="false" data-lens="digicam">
            <span class="lens-num">03</span>
            <div class="lens-info">
              <strong>DIGICAM CYBERSHOT 2004</strong>
              <small>Flash digital dan tanggal oranye.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
          <button class="lens-showcase-option" type="button" role="tab" aria-selected="false" data-lens="vhs">
            <span class="lens-num">04</span>
            <div class="lens-info">
              <strong>VHS CAMCORDER GLITCH</strong>
              <small>Scanline kaset pita dan RGB shift.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
          <button class="lens-showcase-option" type="button" role="tab" aria-selected="false" data-lens="dreamy">
            <span class="lens-num">05</span>
            <div class="lens-info">
              <strong>DREAMY SOFT PRISM</strong>
              <small>Highlight lembut ala editorial Korea.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
        </div>
      </div>
      <div class="lens-preview-stage" aria-live="polite">
        <div class="lens-viewfinder" data-preview-lens="fisheye">
          <div class="lens-preview-art"><img class="lens-photo" src="/images/friends-photo-booth.jpg" alt="Sekelompok teman berpose bersama di photobooth" loading="lazy" decoding="async" /></div>
          <div class="preview-hud"><span>● REC</span><span>00:04:12</span></div>
          <div class="preview-date">2004.08.24</div>
        </div>
        <div class="lens-preview-caption"><strong data-preview-name>Fisheye 360°</strong><span data-preview-desc>Cembung ekstrem, ala kamera aksi 90an.</span></div>
      </div>
    </section>

    <section class="frames-section section-pad" id="frames">
      <div class="frames-showcase" aria-label="Contoh koleksi frame Mivora Photo">
        <div class="sample-strip sample-left"><div class="sample-picture picture-one"><i /></div><div class="sample-picture picture-two"><i /></div><div class="sample-picture picture-three"><i /></div><b>CORE MEMORY</b><small>MIVORA PHOTO · 2026</small></div>
        <div class="sample-strip sample-mid"><small>INSTANT PHOTO CLUB</small><div class="sample-picture picture-four"><i /></div><div class="sample-picture picture-five"><i /></div><b>BESTIES<br />FOREVER</b><small>GOOD TIMES, NO FILTER</small></div>
        <div class="sample-strip sample-right"><span>VOL. 04 — SUMMER</span><div class="sample-picture picture-six"><i /></div><b>BEST DAY<br />EVER.</b><small>JAKARTA · 2026</small></div>
        <a class="frame-source-credit" href="https://unsplash.com/photos/friends-pose-happily-in-a-photo-booth-with-props-xCFUDBrdeA4" target="_blank" rel="noopener noreferrer">Foto contoh: Kevin Torres / Unsplash ↗</a>
      </div>
      <div class="frames-copy">
        <h2>Ratusan vibes bingkai.<br /><em>Nggak ada kata bosan.</em></h2>
        <p>Bukan cuma bingkai polosan warna-warni. Ada struk minimarket, pass gigs, tahun album sekolah, sampai frame museum yang bikin foto biasa jadi memorabilia geng.</p>
        <div class="frame-category-preview" role="tablist" aria-label="Kategori contoh frame">
          <button type="button" class="is-active" data-frame-category="y2k">Y2K Cyber</button>
          <button type="button" data-frame-category="receipt">Retro Receipt</button>
          <button type="button" data-frame-category="museum">Museum Art</button>
          <button type="button" data-frame-category="gigs">Gigs & Music</button>
          <button type="button" data-frame-category="coquette">Coquette Ribbon</button>
          <button type="button" data-frame-category="yearbook">90s Yearbook</button>
          <button type="button" data-frame-category="cinema">Cinema Ticket</button>
          <button type="button" data-frame-category="editorial">Minimalist Editorial</button>
        </div>
        <a href="/studio" class="text-link">Pilih frame di studio <span>↗</span></a>
      </div>
    </section>

    <section class="live-section section-pad">
      <div class="live-copy">
        <h2>Bukan cuma foto diam.<br /><em>Bikin Live Photo & Boomerang!</em></h2>
        <p>Setiap senyum, kedipan, dan gaya absurd sebelum blitz menyala ikut terekam. Simpan photostrip sebagai foto resolusi tinggi sekaligus video WebM siap kirim ke IG Story & TikTok.</p>
        <a class="text-link" href="/studio">Coba bikin punya kamu <span>↗</span></a>
      </div>
      <div class="live-art" aria-label="Contoh photostrip animasi dengan frame Mivora">
        <div class="live-paper"><div class="live-photo"></div><b>BESTIES IN MOTION</b><small>▶ LOOP PREVIEW · 00:02</small></div>
      </div>
    </section>

    <section class="faq-section section-pad" id="faq">
      <div class="faq-intro"><h2>Yang sering<br /><em>ditanyain.</em></h2><p>Masih bingung? Tulis ke <a href={`mailto:${brand.email}`}>{brand.email}</a>, kami bantu.</p></div>
      <div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-main">
      <div class="footer-brand"><a class="wordmark" href="#top"><span>✦</span> MIVORA <i>PHOTO</i></a><p>Your Pocket Creative Photobooth.</p><div class="footer-social"><a href={brand.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={brand.tiktok} target="_blank" rel="noopener noreferrer">TikTok ↗</a><span>@mivora.photo</span></div></div>
      <div class="footer-contact"><h3>Datang atau sapa kami.</h3><address>{brand.address}</address><a href={`mailto:${brand.email}`}>{brand.email}</a><a href={`mailto:${brand.partnershipEmail}`}>{brand.partnershipEmail}</a><a href="https://wa.me/6281288994021">WhatsApp {brand.phone}</a><small>Senin–Minggu, 09.00–21.00 WIB</small></div>
      <div class="footer-links"><h3>Jelajahi Mivora.</h3><a href="#lenses">Efek lensa</a><a href="#frames">Koleksi bingkai</a><a href="/panduan">Panduan studio</a><a href="/studio">Buka studio</a><a href="#faq">Bantuan & FAQ</a><a href={`mailto:${brand.partnershipEmail}?subject=Custom%20event%20frame`}>Request custom event frame</a><a href="#privacy" data-privacy-open>Privacy policy</a><a href="/terms">Terms of service</a><a href="/brand">Brand guidelines</a></div>
    </div>
    <div class="footer-bottom"><span>© 2026 PT Mivora Kreasi Visual</span><span>FOTO KAMU. ATURAN KAMU. SEMUA TETAP DI PERANGKATMU.</span><a href="#top">Ke atas ↑</a></div>
    <dialog class="privacy-dialog" id="privacy"><button type="button" data-privacy-close aria-label="Tutup">×</button><p class="section-kicker">PRIVACY, PLAIN & SIMPLE</p><h2>Foto kamu tetap milikmu.</h2><p>Kamera dan file gambar diproses secara lokal di browser. Mivora Photo tidak menerima atau menyimpan foto. QR hasil photobooth berisi pratinjau kecil yang dikompresi di dalam kode QR itu sendiri; file resolusi tinggi hanya tersedia di perangkat tempat foto dibuat. Matikan kamera atau tutup tab untuk menghentikan sesi.</p></dialog>
  </footer>

  <script>
    const lensDescriptions: Record<string, [string, string]> = {
      fisheye: ['Fisheye 360°', 'Cembung ekstrem, ala kamera aksi 90an.'],
      leica: ['Leica 35mm', 'Hangat, bertekstur, dengan light leak tipis.'],
      digicam: ['Digicam 2004', 'Flash digital dan tanggal oranye.'],
      vhs: ['VHS Camcorder', 'Scanline kaset pita dan RGB shift.'],
      dreamy: ['Dreamy Soft Prism', 'Highlight lembut ala editorial Korea.'],
    };
    document.querySelectorAll<HTMLButtonElement>('.lens-showcase-option').forEach((button) => {
      button.addEventListener('mouseenter', () => setLens(button));
      button.addEventListener('focus', () => setLens(button));
      button.addEventListener('click', () => setLens(button));
    });
    function setLens(button: HTMLButtonElement) {
      document.querySelectorAll('.lens-showcase-option').forEach((item) => { item.classList.remove('is-active'); item.setAttribute('aria-selected', 'false'); });
      button.classList.add('is-active'); button.setAttribute('aria-selected', 'true');
      const key = button.dataset.lens ?? 'fisheye';
      const preview = document.querySelector<HTMLElement>('.lens-viewfinder');
      if (preview) preview.dataset.previewLens = key;
      const text = lensDescriptions[key] ?? lensDescriptions.fisheye;
      document.querySelector('[data-preview-name]')!.textContent = text[0];
      document.querySelector('[data-preview-desc]')!.textContent = text[1];
    }
    const samplePalettes: Record<string, { background: string; foreground: string; picture: string }> = {
      y2k: { background: '#c8effb', foreground: '#121212', picture: '#9fcbd7' },
      receipt: { background: '#f5f0e2', foreground: '#20211d', picture: '#d7c9a8' },
      museum: { background: '#d9c8a5', foreground: '#35291d', picture: '#a88e64' },
      gigs: { background: '#f3b94d', foreground: '#241c19', picture: '#bb5140' },
      coquette: { background: '#f8dde5', foreground: '#7b3047', picture: '#f0b8cb' },
      yearbook: { background: '#e9e3d5', foreground: '#292929', picture: '#a8b7a1' },
      cinema: { background: '#f1c879', foreground: '#201a18', picture: '#b96350' },
      editorial: { background: '#fffdf5', foreground: '#171717', picture: '#c9d8d0' },
    };
    document.querySelectorAll<HTMLButtonElement>('[data-frame-category]').forEach((button) => button.addEventListener('click', () => {
      document.querySelectorAll('[data-frame-category]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
      const palette = samplePalettes[button.dataset.frameCategory ?? 'y2k'] ?? samplePalettes.y2k;
      document.querySelectorAll<HTMLElement>('.sample-strip').forEach((strip, index) => {
        strip.dataset.theme = `${button.dataset.frameCategory}-${index + 1}`;
        strip.style.backgroundColor = palette.background;
        strip.style.color = palette.foreground;
        strip.querySelectorAll<HTMLElement>('.sample-picture').forEach((picture) => { picture.style.backgroundColor = palette.picture; });
      });
    }));
    const privacyDialog = document.querySelector<HTMLDialogElement>('#privacy');
    document.querySelector('[data-privacy-open]')?.addEventListener('click', (event) => { event.preventDefault(); privacyDialog?.showModal(); });
    document.querySelector('[data-privacy-close]')?.addEventListener('click', () => privacyDialog?.close());
  </script>
</BaseLayout>
