---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand, faqs } from '../data/brand';
import { assetUrl } from '../lib/paths';

const friendsPhoto = assetUrl('/images/friends-photo-booth.jpg');
---

<BaseLayout>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Ruang Kilas, ke atas"><span>✦</span> RUANG <i>KILAS</i></a>
    <nav aria-label="Navigasi utama">
      <a href="#lenses">Efek lensa</a>
      <a href="#frames">Koleksi frame</a>
      <a href={assetUrl('/panduan')}>Panduan</a>
      <a href={assetUrl('/studio')}>Studio</a>
    </nav>
    <a class="header-cta" href={assetUrl('/studio')}>Buka photobooth <span>↗</span></a>
  </header>

  <main id="top">
    <section class="hero-section">
      <div class="hero-bg-photos" aria-hidden="true">
        <div class="hero-mini-photo photo-left-top">
          <div class="mini-frame">
            <img src={friendsPhoto} alt="" class="mini-img img-classic-warm" />
          </div>
          <span class="mini-caption">analog '04</span>
        </div>
        <div class="hero-mini-photo photo-left-bottom">
          <div class="mini-frame">
            <img src={friendsPhoto} alt="" class="mini-img img-classic-film" />
          </div>
          <span class="mini-caption">besties</span>
        </div>
        <div class="hero-mini-photo photo-right-top">
          <div class="mini-frame">
            <img src={friendsPhoto} alt="" class="mini-img img-classic-mono" />
          </div>
          <span class="mini-caption">instant roll</span>
        </div>
      </div>
      <div class="hero-copy">
        <h1 class="split-title">Abadikan momen seru,<br /><em>langsung dari browser Anda.</em></h1>
        <p class="hero-lede">Studio photobooth online instan tanpa antre. Nikmati beragam efek lensa kamera vintage, kombinasikan bingkai tematik estetik, dan simpan photostrip berkualitas tinggi bersama orang terdekat detik ini juga.</p>
        <div class="hero-actions"><a class="button-primary" href={assetUrl('/studio')}>Mulai photobooth sekarang <span>↗</span></a><a class="button-secondary" href="#frames">Lihat koleksi frame <span>↓</span></a></div>
      </div>
    </section>

    <section class="lens-section section-pad" id="lenses">
      <div class="lens-copy">
        <h2>Satu webcam.<br /><em>Nuansa studio fotografi profesional.</em></h2>
        <p class="section-intro">Pilih efek lensa kamera di bawah untuk melihat simulasi pratinjau foto secara langsung.</p>
        <div class="lens-showcase-list" role="tablist" aria-label="Pilihan efek lensa">
          <button class="lens-showcase-option is-active" type="button" role="tab" aria-selected="true" data-lens="fisheye">
            <span class="lens-num">01</span>
            <div class="lens-info">
              <strong>FISHEYE 360° ULTRA-WIDE</strong>
              <small>Cembung ekstrem, ala kamera aksi 90an.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
          <button class="lens-showcase-option" type="button" role="tab" aria-selected="false" data-lens="leica">
            <span class="lens-num">02</span>
            <div class="lens-info">
              <strong>LEICA 35MM FILM GRAIN</strong>
              <small>Hangat, bertekstur, dengan light leak tipis.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
          <button class="lens-showcase-option" type="button" role="tab" aria-selected="false" data-lens="digicam">
            <span class="lens-num">03</span>
            <div class="lens-info">
              <strong>DIGICAM CYBERSHOT 2004</strong>
              <small>Flash digital dan tanggal oranye.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
          <button class="lens-showcase-option" type="button" role="tab" aria-selected="false" data-lens="vhs">
            <span class="lens-num">04</span>
            <div class="lens-info">
              <strong>VHS CAMCORDER GLITCH</strong>
              <small>Scanline kaset pita dan RGB shift.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
          <button class="lens-showcase-option" type="button" role="tab" aria-selected="false" data-lens="dreamy">
            <span class="lens-num">05</span>
            <div class="lens-info">
              <strong>DREAMY SOFT PRISM</strong>
              <small>Highlight lembut ala editorial Korea.</small>
            </div>
            <span class="lens-arrow" aria-hidden="true">→</span>
          </button>
        </div>
      </div>
      <div class="lens-preview-stage" aria-live="polite">
        <div class="lens-viewfinder" data-preview-lens="fisheye">
          <div class="lens-preview-art"><img class="lens-photo" src={friendsPhoto} alt="Sekelompok teman berpose bersama di photobooth" loading="lazy" decoding="async" /></div>
          <div class="preview-hud"><span>● REC</span><span>00:04:12</span></div>
          <div class="preview-date">2004.08.24</div>
        </div>
        <div class="lens-preview-caption"><strong data-preview-name>Fisheye 360°</strong><span data-preview-desc>Cembung ekstrem, ala kamera aksi 90an.</span></div>
      </div>
    </section>

    <section class="frames-section section-pad" id="frames">
      <div class="frames-showcase" aria-label="Contoh koleksi frame Ruang Kilas">
        <div class="sample-strip sample-left"><div class="sample-picture picture-one"><i /></div><div class="sample-picture picture-two"><i /></div><div class="sample-picture picture-three"><i /></div><b>CORE MEMORY</b><small>RUANG KILAS · 2026</small></div>
        <div class="sample-strip sample-mid"><small>INSTANT PHOTO CLUB</small><div class="sample-picture picture-four"><i /></div><div class="sample-picture picture-five"><i /></div><b>BESTIES<br />FOREVER</b><small>GOOD TIMES, NO FILTER</small></div>
        <div class="sample-strip sample-right"><span>VOL. 04 — SUMMER</span><div class="sample-picture picture-six"><i /></div><b>BEST DAY<br />EVER.</b><small>JAKARTA · 2026</small></div>
        <a class="frame-source-credit" href="https://unsplash.com/photos/friends-pose-happily-in-a-photo-booth-with-props-xCFUDBrdeA4" target="_blank" rel="noopener noreferrer">Foto contoh: Kevin Torres / Unsplash ↗</a>
      </div>
      <div class="frames-copy">
        <h2>Ragam pilihan bingkai.<br /><em>Sentuhan estetik di setiap jepretan.</em></h2>
        <p>Bukan sekadar bingkai polos biasa. Tersedia tema retro receipt, festival pass, 35mm film roll, hingga desain minimalis editorial yang membuat setiap momen kebersamaan terasa istimewa.</p>
        <div class="frame-category-preview" role="tablist" aria-label="Kategori contoh frame">
          <button type="button" class="is-active" data-frame-category="y2k">Y2K Cyber</button>
          <button type="button" data-frame-category="receipt">Retro Receipt</button>
          <button type="button" data-frame-category="museum">Museum Art</button>
          <button type="button" data-frame-category="gigs">Gigs & Music</button>
          <button type="button" data-frame-category="coquette">Coquette Ribbon</button>
          <button type="button" data-frame-category="yearbook">90s Yearbook</button>
          <button type="button" data-frame-category="cinema">Cinema Ticket</button>
          <button type="button" data-frame-category="editorial">Minimalist Editorial</button>
        </div>
        <a href={assetUrl('/studio')} class="text-link">Pilih frame di studio <span>↗</span></a>
      </div>
    </section>

    <section class="live-section section-pad">
      <div class="live-copy">
        <h2>Bukan cuma foto diam.<br /><em>Abadikan Live Photo & Boomerang!</em></h2>
        <p>Rekam senyum dan ekspresi spontan sebelum blitz menyala. Simpan photostrip sebagai foto resolusi tinggi (JPG) dan video gerak singkat (WebM) yang siap dibagikan ke media sosial.</p>
        <a class="text-link" href={assetUrl('/studio')}>Coba buat photostrip Anda <span>↗</span></a>
      </div>
      <div class="live-art" aria-label="Contoh photostrip animasi dengan frame Ruang Kilas">
        <div class="live-paper"><div class="live-photo"></div><b>BESTIES IN MOTION</b><small>▶ LOOP PREVIEW · 00:02</small></div>
      </div>
    </section>

    <section class="faq-section section-pad" id="faq">
      <div class="faq-intro"><h2>Pertanyaan yang<br /><em>sering diajukan.</em></h2><p>Punya pertanyaan lain? Hubungi kami di <a href={`mailto:${brand.email}`}>{brand.email}</a>.</p></div>
      <div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-main">
      <div class="footer-brand"><a class="wordmark" href="#top"><span>✦</span> RUANG <i>KILAS</i></a><p>Photobooth Online Kreatif untuk Setiap Momen.</p><div class="footer-social"><a href={brand.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={brand.tiktok} target="_blank" rel="noopener noreferrer">TikTok ↗</a><span>@ruangkilas.id</span></div></div>
      <div class="footer-contact"><h3>Hubungi atau kunjungi kami.</h3><address>{brand.address}</address><a href={`mailto:${brand.email}`}>{brand.email}</a><a href={`mailto:${brand.partnershipEmail}`}>{brand.partnershipEmail}</a><a href="https://wa.me/6281288994021">WhatsApp {brand.phone}</a><small>Senin–Minggu, 09.00–21.00 WIB</small></div>
      <div class="footer-links"><h3>Jelajahi Ruang Kilas.</h3><a href="#lenses">Efek lensa</a><a href="#frames">Koleksi bingkai</a><a href={assetUrl('/panduan')}>Panduan studio</a><a href={assetUrl('/studio')}>Buka studio</a><a href="#faq">Bantuan & FAQ</a><a href={`mailto:${brand.partnershipEmail}?subject=Custom%20event%20frame`}>Request custom event frame</a><a href="#privacy" data-privacy-open>Kebijakan privasi</a><a href={assetUrl('/terms')}>Ketentuan layanan</a><a href={assetUrl('/brand')}>Panduan brand</a></div>
    </div>
    <div class="footer-bottom"><span>© 2026 Ruang Kilas. Hak cipta dilindungi.</span><span>FOTO ANDA. PRIVASI ANDA. 100% DIPROSES LOKAL DI PERANGKAT.</span><a href="#top">Ke atas ↑</a></div>
    <dialog class="privacy-dialog" id="privacy"><button type="button" data-privacy-close aria-label="Tutup">×</button><p class="section-kicker">PRIVACY, PLAIN & SIMPLE</p><h2>Foto Anda sepenuhnya milik Anda.</h2><p>Seluruh proses kamera, filter, dan berkas foto berlangsung secara lokal di memori browser perangkat Anda. Ruang Kilas tidak pernah menerima, mengunggah, atau menyimpan foto Anda di server mana pun. Kode QR yang dihasilkan menyimpan pratinjau mini langsung di dalam kode tersebut, dan berkas resolusi penuh tetap berada di perangkat Anda. Matikan kamera atau tutup tab untuk mengakhiri sesi pemotretan kapan saja.</p></dialog>
  </footer>

  <script>
    const lensDescriptions: Record<string, [string, string]> = {
      fisheye: ['Fisheye 360°', 'Cembung ekstrem, ala kamera aksi 90an.'],
      leica: ['Leica 35mm', 'Hangat, bertekstur, dengan light leak tipis.'],
      digicam: ['Digicam 2004', 'Flash digital dan tanggal oranye.'],
      vhs: ['VHS Camcorder', 'Scanline kaset pita dan RGB shift.'],
      dreamy: ['Dreamy Soft Prism', 'Highlight lembut ala editorial Korea.'],
    };
    document.querySelectorAll<HTMLButtonElement>('.lens-showcase-option').forEach((button) => {
      button.addEventListener('mouseenter', () => setLens(button));
      button.addEventListener('focus', () => setLens(button));
      button.addEventListener('click', () => setLens(button));
    });
    function setLens(button: HTMLButtonElement) {
      document.querySelectorAll('.lens-showcase-option').forEach((item) => { item.classList.remove('is-active'); item.setAttribute('aria-selected', 'false'); });
      button.classList.add('is-active'); button.setAttribute('aria-selected', 'true');
      const key = button.dataset.lens ?? 'fisheye';
      const preview = document.querySelector<HTMLElement>('.lens-viewfinder');
      if (preview) preview.dataset.previewLens = key;
      const text = lensDescriptions[key] ?? lensDescriptions.fisheye;
      document.querySelector('[data-preview-name]')!.textContent = text[0];
      document.querySelector('[data-preview-desc]')!.textContent = text[1];
    }
    const samplePalettes: Record<string, { background: string; foreground: string; picture: string }> = {
      y2k: { background: '#c8effb', foreground: '#121212', picture: '#9fcbd7' },
      receipt: { background: '#f5f0e2', foreground: '#20211d', picture: '#d7c9a8' },
      museum: { background: '#d9c8a5', foreground: '#35291d', picture: '#bfad8a' },
      gigs: { background: '#f3b94d', foreground: '#241c19', picture: '#c8933b' },
      coquette: { background: '#f8dde5', foreground: '#7b3047', picture: '#dbbfca' },
      yearbook: { background: '#e9e3d5', foreground: '#292929', picture: '#cfc8b7' },
      cinema: { background: '#f1c879', foreground: '#201a18', picture: '#cb9e4d' },
      editorial: { background: '#f5f1e8', foreground: '#171717', picture: '#dad5cb' },
    };
    document.querySelectorAll<HTMLButtonElement>('[data-frame-category]').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll('[data-frame-category]').forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');
        const key = button.dataset.frameCategory ?? 'y2k';
        const palette = samplePalettes[key] ?? samplePalettes.y2k;
        const target = document.querySelector<HTMLElement>('.sample-mid');
        if (target) {
          target.style.backgroundColor = palette.background;
          target.style.color = palette.foreground;
          target.querySelectorAll<HTMLElement>('.sample-picture i').forEach((picture) => { picture.style.backgroundColor = palette.picture; });
        }
      });
    });
    const privacyDialog = document.querySelector<HTMLDialogElement>('#privacy');
    document.querySelectorAll('[data-privacy-open]').forEach((button) => {
      button.addEventListener('click', (event) => { event.preventDefault(); privacyDialog?.showModal(); });
    });
    document.querySelectorAll('[data-privacy-close]').forEach((button) => {
      button.addEventListener('click', () => privacyDialog?.close());
    });
    privacyDialog?.addEventListener('click', (event) => {
      if (event.target === privacyDialog) privacyDialog.close();
    });
  </script>
</BaseLayout>
