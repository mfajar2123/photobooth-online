---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeddingBooth from '../components/wedding/WeddingBooth';
import { assetUrl } from '../lib/paths';
import '../styles/wedding.css';

const heroSrc = assetUrl('/images/bg-hero-ripkii.jpeg');
const frameSrc = assetUrl('/images/frame-ripki-baru-hd.png');
const homeHref = assetUrl('/');
---

<BaseLayout
  title="Ripki & Aura — Bilik Foto Virtual, Sukabumi"
  description="Foto langsung dari peramban di pernikahan Ripki & Aura, Sukabumi, 28 November 2026. Pilih bingkai, unduh foto atau video, lalu bagikan."
  keywords="wedding ripki aura, wedding photobooth, photobooth sukabumi, wedding photobooth online, foto wedding online"
  ogImage="/images/wedding-ripki-og.jpg"
  ogImageType="image/jpeg"
  ogImageAlt="Ripki & Aura — Sukabumi, 28 November 2026"
  noindex={true}
>
  <WeddingBooth client:load heroSrc={heroSrc} frameSrc={frameSrc} homeHref={homeHref} />
</BaseLayout>
