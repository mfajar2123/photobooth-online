---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { assetUrl } from '../lib/paths';

const breadcrumbs = [
  { name: 'Beranda', item: '/' },
  { name: 'Panduan Studio', item: '/panduan' },
];

const howToSchema = {
  '@type': 'HowTo',
  name: 'Cara Menggunakan Studio Photobooth Online Ruang Kilas',
  description: 'Panduan praktis 4 langkah membuat photostrip estetik dan video Boomerang langsung dari browser tanpa instalasi software.',
  totalTime: 'PT3M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Pilih format kamera & efek lensa',
      text: 'Buka studio di browser, pilih format Potret atau Landscape, dan pilih efek lensa seperti Fisheye 360, Leica 35mm, Digicam 2004, VHS Camcorder, atau Dreamy Soft Prism.',
      url: 'https://ruangkilas.my.id/panduan/#step-1',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Pilih tema bingkai & motif latar',
      text: 'Jelajahi koleksi bingkai tematik estetik (Retro Receipt, Y2K Cyber, 35mm Film Roll, Tokyo Purikura, dll) dan sesuaikan warna latar belakang.',
      url: 'https://ruangkilas.my.id/panduan/#step-2',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Pilih filter warna, caption & stiker',
      text: 'Terapkan filter tone warna foto, tambahkan tulisan nama geng atau tanggal kenangan, serta tempel stiker retro estetik dengan drag and drop.',
      url: 'https://ruangkilas.my.id/panduan/#step-3',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Unduh foto atau Boomerang',
      text: 'Unduh foto JPG atau Boomerang jika didukung browser, lalu periksa file di perangkat.',
      url: 'https://ruangkilas.my.id/panduan/#step-4',
    },
  ],
};
---

<BaseLayout
  title="Cara Menggunakan Photobooth Online di HP | Ruang Kilas"
  description="Panduan photobooth online Ruang Kilas: aktifkan kamera, ambil foto, pilih bingkai dan stiker, lalu unduh photostrip dari browser."
  breadcrumbs={breadcrumbs}
  extraSchema={howToSchema}
  includeWebApplication={true}
>
  <!-- Site Header -->
    <SiteHeader ctaLabel="Buka photobooth" />

  <main class="guide-page">
    <!-- Hero Section: Clean, Calm & To The Point -->
    <section class="guide-hero">
      <div class="guide-hero-copy">
        <a class="guide-breadcrumb" href={assetUrl('/')}><span class="nav-arrow">←</span> Kembali ke beranda</a>
        <h1>Panduan studio.<br /><em>4 langkah praktis.</em></h1>
        <p class="hero-lede">
          Alur pemotretan, kustomisasi bingkai, stiker, hingga simpan dan cetak langsung dari browser tanpa instalasi software apa pun.
        </p>
      </div>
    </section>

    <!-- 4 Clear Steps -->
    <section class="guide-steps-container" id="langkah-langkah">
      
      <!-- STEP 1 -->
      <article class="guide-step-card" id="step-1">
        <div class="guide-step-info">
          <span class="guide-step-tag">01 / KAMERA</span>
          <h2 class="guide-step-title">Pilih format kamera & efek lensa</h2>
          <ul class="guide-features-list">
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Format ukuran foto:</strong> Pilihan orientasi Potret · Story (1 foto) atau Landscape (1, 2, atau 3 foto) sesuai konsep posenya.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Efek lensa real-time:</strong> Pilih tampilan <em>Original</em> (tanpa efek) atau 5 lensa vintage: Fisheye 360°, Leica 35mm, Digicam 2004, VHS Camcorder, dan Dreamy Soft Prism langsung di preview kamera.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Timer & kontrol kamera:</strong> Atur hitung mundur 1s, 3s, 5s, atau 10s. Fitur Mirror kamera diatur default OFF serta tombol Balik kamera depan/belakang.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Retake per slot:</strong> Klik salah satu kotak thumbnail slot foto untuk mengambil ulang pose tersebut tanpa mengulang foto lainnya.</div>
            </li>
          </ul>
        </div>

        <div class="guide-step-visual" aria-hidden="true">
          <div class="visual-header-bar">
            <span>● VIEWFINDER</span>
            <span>01 KAMERA</span>
          </div>
          <div class="visual-mock-stage">
            <div style="font: 800 13px var(--mono);">📷 KAMERA AKTIF</div>
            <div style="color: #6d675b; font-size: 11px; margin-top: 4px;">Timer: 3s · Lensa: Original</div>
          </div>
          <div class="mock-slots-grid">
            <div class="mock-slot active">1 ✓</div>
            <div class="mock-slot active">2 ✓</div>
            <div class="mock-slot active">3 ✓</div>
            <div class="mock-slot active">4 ✓</div>
          </div>
          <div class="mock-btn-row">
            <span class="mock-pill poppy">Lanjut ke Bingkai <span class="nav-arrow">→</span></span>
          </div>
        </div>
      </article>

      <!-- STEP 2 -->
      <article class="guide-step-card reverse" id="step-2">
        <div class="guide-step-info">
          <span class="guide-step-tag">02 / BINGKAI</span>
          <h2 class="guide-step-title">Pilih tema bingkai & motif latar</h2>
          <ul class="guide-features-list">
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Koleksi bingkai estetik:</strong> Ragam desain tematik mulai dari Signature (Kilas Butter, Atelier Noir, Swiss), Retro (Struk Belanja, 35mm Film Roll, Festival Pass), hingga Cute & Pop (Tokyo Purikura, Y2K Cyber, Coquette Ribbon).</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Kustom warna & motif:</strong> Bebas atur warna bingkai dengan palet warna atau kode hex, serta pilihan pola motif (Polos, Dots, Lines, Grid).</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Navigasi bingkai cepat:</strong> Gunakan tombol navigasi <em>Sebelumnya</em> dan <em>Berikutnya</em> untuk menjelajahi pilihan bingkai dengan mudah.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Fleksibel kembali:</strong> Klik tombol <em><span class="nav-arrow">←</span> Kembali ke Kamera</em> kapan saja jika ingin memperbaiki atau mengulang foto.</div>
            </li>
          </ul>
        </div>

        <div class="guide-step-visual" aria-hidden="true">
          <div class="visual-header-bar">
            <span>● BINGKAI & PALET</span>
            <span>02 BINGKAI</span>
          </div>
          <div class="visual-mock-stage" style="background: #fff3b0;">
            <div style="font: 800 11px var(--mono); color: #161412;">RUANG KILAS KEEPSAKE</div>
            <div style="display: flex; gap: 6px; margin: 10px 0;">
              <div style="width: 28px; height: 28px; background: #ea3d2f; border: 1.5px solid #000;"></div>
              <div style="width: 28px; height: 28px; background: #8ecae6; border: 1.5px solid #000;"></div>
              <div style="width: 28px; height: 28px; background: #161412; border: 1.5px solid #000;"></div>
            </div>
            <div style="font: 700 9px var(--mono); color: #555;">Kategori: Signature / Retro</div>
          </div>
          <div class="mock-btn-row">
            <span class="mock-pill"><span class="nav-arrow">←</span> Kembali</span>
            <span class="mock-pill poppy">Lanjut ke Filter & Stiker <span class="nav-arrow">→</span></span>
          </div>
        </div>
      </article>

      <!-- STEP 3 -->
      <article class="guide-step-card" id="step-3">
        <div class="guide-step-info">
          <span class="guide-step-tag">03 / STIKER & FILTER</span>
          <h2 class="guide-step-title">Pilih filter warna, caption & stiker</h2>
          <ul class="guide-features-list">
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Filter warna (No Filter default):</strong> Tersedia opsi <em>No Filter</em> sebagai pilihan bawaan agar tone lensa tetap murni, serta pilihan Classic, Film, B&W, Warm, dan Vivid.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Caption nama geng:</strong> Tuliskan nama geng, lokasi, atau tanggal kenangan (maks. 40 karakter) yang langsung tercetak di bagian bawah frame.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Stiker retro estetik:</strong> Tempel pilihan stiker ikonik bintang ✦, hati ♡, pita 🎀, senyum ☻, bunga ✿, atau CHEESE!.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Drag & drop leluasa:</strong> Geser stiker bebas ke posisi mana pun di atas photostrip dan dobel klik stiker untuk langsung menghapusnya.</div>
            </li>
          </ul>
        </div>

        <div class="guide-step-visual" aria-hidden="true">
          <div class="visual-header-bar">
            <span>● FILTER & STIKER</span>
            <span>03 FILTER</span>
          </div>
          <div class="visual-mock-stage">
            <div style="font: 800 12px var(--display);">BESTIE SELAMANYA</div>
            <div style="display: flex; gap: 8px; margin: 10px 0; font-size: 18px;">
              <span>✦</span><span>♡</span><span>🎀</span><span style="font: 800 10px var(--mono); border: 1px solid #000; padding: 2px 4px;">CHEESE!</span>
            </div>
            <div style="font: 700 9px var(--mono); color: #888;">Filter: No Filter · Geser stiker</div>
          </div>
          <div class="mock-btn-row">
            <span class="mock-pill"><span class="nav-arrow">←</span> Kembali</span>
            <span class="mock-pill poppy">Lanjut ke Simpan & Cetak <span class="nav-arrow">→</span></span>
          </div>
        </div>
      </article>

      <!-- STEP 4 -->
      <article class="guide-step-card reverse" id="step-4">
        <div class="guide-step-info">
          <span class="guide-step-tag">04 / SIMPAN</span>
          <h2 class="guide-step-title">Unduh foto dan Boomerang</h2>
          <ul class="guide-features-list">
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Unduh foto JPG:</strong> Simpan hasil ke perangkat, lalu periksa ukuran dan kualitasnya sebelum dicetak.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Boomerang:</strong> Pilih durasi 3 atau 4 detik dan unduh video jika browser mendukung ekspor. Format video bergantung pada perangkat dan browser.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Bagikan dari perangkat:</strong> Gunakan tombol bagikan jika didukung, atau kirim berkas JPG yang sudah diunduh melalui aplikasi pilihan Anda.</div>
            </li>
            <li>
              <span class="guide-check-icon">✓</span>
              <div><strong>Edit ulang fleksibel:</strong> Klik tombol kembali kapan saja untuk mengubah bingkai, filter, atau stiker tanpa perlu mengulang sesi foto dari awal.</div>
            </li>
          </ul>
        </div>

        <div class="guide-step-visual" aria-hidden="true">
          <div class="visual-header-bar">
            <span>● HASIL AKHIR & CETAK</span>
            <span>04 SIMPAN</span>
          </div>
          <div class="visual-mock-stage" style="background: #fffdf5;">
            <div style="font: 800 13px var(--display); color: var(--poppy); margin-bottom: 6px;">Kenanganmu Siap!</div>
            <div style="font: 700 9px var(--mono); color: #333; margin-bottom: 8px;">Format: Foto Cetak & Video Boomerang</div>
            <div style="width: 44px; height: 44px; border: 1.5px solid var(--ink); background: var(--butter); display: grid; place-items: center; font-size: 18px;">■</div>
          </div>
          <div class="mock-btn-row">
            <span class="mock-pill poppy">Unduh Foto <span class="nav-arrow">↓</span></span>
            <span class="mock-pill sky">Bagikan foto ↗</span>
          </div>
        </div>
      </article>

      <!-- Clean Direct Action Link -->
      <div style="text-align: center; padding-top: 10px;">
        <a class="button-primary guide-cta-btn" href={assetUrl('/studio')}>Buka Studio Photobooth Sekarang <span class="nav-arrow">↗</span></a>
      </div>

    </section>

    <!-- 3 Simple Pro-Tips -->
    <section class="guide-tips-section">
      <div class="guide-section-head">
        <p class="section-kicker">TIPS & TRIK</p>
        <h2>Hasil foto maksimal dalam 3 tips.</h2>
      </div>

      <div class="guide-tips-grid">
        <div class="guide-tip-card">
          <span class="tip-badge">01</span>
          <h3>Cahaya Menghadap Wajah</h3>
          <p>
            Duduklah menghadap jendela atau lampu terang. Hindari membelakangi cahaya agar tone filter vintage terlihat tajam.
          </p>
        </div>

        <div class="guide-tip-card">
          <span class="tip-badge">02</span>
          <h3>Mode Fullscreen</h3>
          <p>
            Klik tombol <strong>Fullscreen ⤢</strong> di kanan atas studio untuk merasakan pengalaman bilik photobooth tanpa gangguan tab browser.
          </p>
        </div>

        <div class="guide-tip-card">
          <span class="tip-badge">03</span>
          <h3>100% Privasi di Browser</h3>
          <p>
            Foto diproses langsung di memori browsermu. Unduh berkas sebelum menutup halaman.
          </p>
        </div>
      </div>
    </section>
    <section class="guide-tips-section" aria-labelledby="bantuan-studio">
      <div class="guide-section-head"><p class="section-kicker">BANTUAN</p><h2 id="bantuan-studio">Jika mengalami kendala.</h2></div>
      <div class="guide-tips-grid">
        <div class="guide-tip-card"><h3>Kamera tidak muncul</h3><p>Buka situs melalui HTTPS, lalu izinkan kamera saat browser meminta akses. Jika sebelumnya ditolak, ubah izin kamera untuk situs ini di pengaturan browser dan tekan Coba lagi. Tutup aplikasi lain yang sedang memakai kamera.</p></div>
        <div class="guide-tip-card"><h3>Foto terlalu gelap</h3><p>Hadapkan wajah ke sumber cahaya, bersihkan lensa, dan periksa pratinjau sebelum mengambil ulang foto. Gunakan tombol balik kamera jika perangkat memiliki lebih dari satu kamera.</p></div>
        <div class="guide-tip-card"><h3>Hasil belum ditemukan</h3><p>Tekan Unduh foto JPG, lalu periksa folder unduhan browser atau aplikasi Berkas. Simpan sebelum menutup halaman. Jika video tidak tersedia di browser, foto JPG tetap dapat diunduh.</p></div>
      </div>
      <p>Butuh bantuan lain? <a href={assetUrl('/kontak/')}>Hubungi Ruang Kilas</a>.</p>
    </section>
  </main>

  <!-- Site Footer -->
    <SiteFooter />
</BaseLayout>
