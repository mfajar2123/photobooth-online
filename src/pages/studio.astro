---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoboothStudio from '../components/photobooth/PhotoboothStudio';
import { assetUrl } from '../lib/paths';
---

<BaseLayout
  title="Studio Photobooth - Ruang Kilas"
  description="Ambil foto potret atau landscape berkualitas tinggi, pilih bingkai tematik dan filter warna, lalu simpan hasil foto atau Boomerang langsung dari perangkat Anda."
>
  <header class="site-header studio-page-header">
    <a class="wordmark" href={assetUrl('/')} aria-label="Ruang Kilas, kembali ke beranda"><span>✦</span> RUANG <i>KILAS</i></a>
    <nav aria-label="Navigasi halaman studio">
      <a href={assetUrl('/#lenses')}>Efek lensa</a>
      <a href={assetUrl('/#frames')}>Koleksi frame</a>
      <a href={assetUrl('/panduan')}>Panduan</a>
    </nav>
    <a class="header-cta" href={assetUrl('/')}>Kembali ke beranda <span>↗</span></a>
  </header>

  <main class="studio-page">
    <section class="studio-section section-pad studio-page-section">
      <a class="studio-back-link" href={assetUrl('/')}>← Kembali ke Ruang Kilas</a>
      <div class="studio-intro">
        <h1>Senyum dulu.<br /><em>Pose belakangan.</em></h1>
      </div>
      <PhotoboothStudio client:load />
      <p class="studio-privacy-note">Privasi terjaga: Seluruh proses foto berlangsung di browser perangkat Anda tanpa penyimpanan di server.</p>
    </section>
  </main>

  <footer class="studio-page-footer">
    <a class="wordmark" href={assetUrl('/')}>✦ RUANG <i>KILAS</i></a>
    <span>FOTO ANDA. PRIVASI ANDA. 100% DIPROSES LOKAL DI PERANGKAT.</span>
    <div style="display: flex; gap: 16px;">
      <a href={assetUrl('/panduan')}>Panduan studio</a>
      <a href={assetUrl('/terms')}>Ketentuan layanan</a>
    </div>
  </footer>
</BaseLayout>
